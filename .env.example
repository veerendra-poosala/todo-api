# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

APP_NAME=Todo API
# development | production
APP_ENV=development

# SQLAlchemy connection URL: postgresql+<driver>://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/todoapplication

# Signs JWTs. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Used only by docker-compose.yml for the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todoapplication
