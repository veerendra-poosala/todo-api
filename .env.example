# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

APP_NAME=Todo API
# development | production
APP_ENV=development

# SQLite stores the whole database in one file. No server needed.
# sqlite:///./todosapp.db   -> relative path (three slashes)
# sqlite:////abs/path.db     -> absolute path (four slashes)
DATABASE_URL=sqlite:///./todosapp.db

# Signs JWTs. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=20
