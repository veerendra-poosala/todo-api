# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets. Placeholders look like <THIS>.
# Step-by-step setup: docs/MSSQL_GUIDE.md

APP_NAME=Todo API
# development | production
APP_ENV=development

# SQLAlchemy connection URL: mssql+pyodbc://user:password@host:port/database?driver=...
#   driver=ODBC+Driver+18+for+SQL+Server  -> the ODBC driver installed on the machine (spaces as +)
#   Encrypt=yes                           -> Driver 18 encrypts by default ("Encrypt: Mandatory" in SSMS)
#   TrustServerCertificate=yes            -> accept the self-signed cert of a local/dev server (dev only!)
# URL-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F, # -> %23
DATABASE_URL=mssql+pyodbc://dev_admin:<PASSWORD>@localhost:1433/todoapplication?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# Signs JWTs. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Used only by docker-compose.yml for the SQL Server container.
# Must meet SQL Server's complexity rules (8+ chars, upper, lower, digit/symbol) or the container exits.
# docker compose refuses to start if this is not set.
MSSQL_SA_PASSWORD=<SA_PASSWORD>
MSSQL_DATABASE=todoapplication
